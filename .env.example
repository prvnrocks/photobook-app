# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...), safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...): server only, bypasses RLS, never expose to the browser
SUPABASE_SECRET_KEY=
# Anthropic API key for the AI pipeline (server only)
ANTHROPIC_API_KEY=
# Mapbox token for reverse geocoding GPS clusters
MAPBOX_TOKEN=
# Stripe secret key (server only)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (server only)
STRIPE_WEBHOOK_SECRET=
# Public app URL, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=
# Shared secret that Vercel Cron sends to the cleanup endpoint
CRON_SECRET=
