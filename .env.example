# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...), safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...): server only, bypasses RLS, never expose to the browser
SUPABASE_SECRET_KEY=
# Anthropic API key for the AI pipeline (server only)
ANTHROPIC_API_KEY=
# AI mode: off | replay | live. Leave empty = auto (key set -> live; no key -> replay locally/preview, off in production)
AI_MODE=
# Comma-separated Supabase user uuids allowed to open /admin/runs (server only)
ADMIN_USER_IDS=
# Mapbox token for reverse geocoding GPS clusters
MAPBOX_TOKEN=
# Stripe secret key (server only). Use sk_test_... in dev/Preview, sk_live_... only in Production.
# Payments stay off ("Payments unavailable") unless BOTH Stripe values below are set.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (server only, whsec_...). Locally: printed by
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# On Vercel: from the Dashboard webhook endpoint. Each environment has its own secret.
STRIPE_WEBHOOK_SECRET=
# Public app URL, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=
# Shared secret that Vercel Cron sends to the cleanup endpoint
CRON_SECRET=
# HMAC secret for password-protected book access cookies (server only, >= 32 bytes).
# Generate with: openssl rand -base64 32   (changing it signs every viewer out of locked books)
BOOK_ACCESS_SECRET=
