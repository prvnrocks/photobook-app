# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...), safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...): server only, bypasses RLS, never expose to the browser
SUPABASE_SECRET_KEY=
# Anthropic API key for the AI pipeline (server only)
ANTHROPIC_API_KEY=
# AI mode: off | replay | live. Leave empty = auto (key set -> live; no key -> replay locally/preview, off in production)
AI_MODE=
# D-059 AI daily budget breaker (server only): USD ceiling for ALL live AI spend per Asia/Dubai day
# (sum of agent_runs.total_cost_usd). Once reached, new AI builds/rebuilds and caption rewrites are
# refused (users keep the rule-based album; "AI is taking a break — try again later"). Suggested at
# launch: 10. Empty or invalid = no budget (unlimited); 0 = refuse all live AI.
AI_DAILY_BUDGET_USD=
# Comma-separated Supabase user uuids allowed to open /admin/runs (server only)
ADMIN_USER_IDS=
# Mapbox token for reverse geocoding GPS clusters
MAPBOX_TOKEN=
# Stripe secret key (server only). Use sk_test_... in dev/Preview, sk_live_... only in Production.
# Payments stay off ("Payments unavailable") unless BOTH Stripe values below are set.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (server only, whsec_...). Locally: printed by
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# On Vercel: from the Dashboard webhook endpoint. Each environment has its own secret.
STRIPE_WEBHOOK_SECRET=
# On Vercel Production (VERCEL_ENV=production) payments stay off unless STRIPE_SECRET_KEY is a live
# key (sk_live_/rk_live_). Set to 1 ONLY for a deliberate test-mode run in Production; leave unset.
STRIPE_ALLOW_TEST_IN_PROD=
# Public app URL, e.g. http://localhost:3000
# Must be the EXACT canonical origin the app answers on (scheme + host, no trailing slash, no path):
# if the domain redirects www <-> apex (or http -> https), use the final target. The PDF renderer
# opens /print/... on this origin and refuses any redirect off it, so a redirecting value makes every
# PDF export fail with navigation_failed.
NEXT_PUBLIC_APP_URL=
# Shared secret that Vercel Cron sends to the cleanup endpoint
CRON_SECRET=
# HMAC secret for password-protected book access cookies (server only, >= 32 bytes).
# Generate with: openssl rand -base64 32   (changing it signs every viewer out of locked books)
BOOK_ACCESS_SECRET=
# PDF export, local dev only: path to a Chrome/Chromium binary for headless rendering (on Vercel the
# bundled @sparticuz/chromium is used). E.g. Playwright's chromium:
#   node -e "console.log(require('playwright').chromium.executablePath())"
PDF_CHROME_PATH=
# PDF export on Vercel: the PDF route needs maxDuration 300 s. On HOBBY this requires Fluid compute
# (vercel.json "fluid": true; Hobby without Fluid caps at 60 s) and runs on 2 GB / 1 vCPU. Pro later:
# see README "Deploy notes". No env var — budget is PDF_MAX_DURATION_SECONDS in src/lib/pdf/rules.ts.
# Vercel Deployment Protection bypass ("Protection Bypass for Automation" secret). Lets the PDF
# renderer open the print route on protected Preview deployments; sent only to the app's own origin.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Sentry error tracking (D-058, EU region de.sentry.io). All optional: without a DSN the SDK is a
# no-op. Events are scrubbed (no bodies, query strings, slugs, ids, emails, captions); no Replay,
# no tracing. Server DSN (falls back to NEXT_PUBLIC_SENTRY_DSN):
SENTRY_DSN=
# Browser DSN (public by design; usually the same value as SENTRY_DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only (Vercel build env): uploads hidden source maps to Sentry, then deletes them from
# the build output. Without it nothing is uploaded and stack traces stay minified.
SENTRY_AUTH_TOKEN=
# Sentry organisation and project slugs (used with SENTRY_AUTH_TOKEN for the source-map upload)
SENTRY_ORG=
SENTRY_PROJECT=
# PostHog product analytics (M9 T14, D-058; EU cloud). Optional: without a key nothing loads.
# Cookieless (memory persistence), no autocapture / replay / surveys / person profiles; only
# allow-listed events with counts/flags; URLs rewritten (/b/:slug, :id, no query strings).
# In the PostHog project settings also enable "Discard client IP data". Project API key (public):
NEXT_PUBLIC_POSTHOG_KEY=
# Ingestion host; empty = https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
